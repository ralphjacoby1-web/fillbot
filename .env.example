# Copy this file to .env and fill in the values.
# .env is gitignored: do NOT commit it.

# --- Required -------------------------------------------------------------

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Cloud Console > APIs & Services > Credentials
# Create an OAuth client ID of type "Web application" and register
# http://localhost:5000/callback as an Authorized redirect URI.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Signs the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# --- Optional (sensible defaults) -----------------------------------------

# Account with unlimited forms. Empty means the limit applies to everyone.
# DEV_EMAIL=

# Limits that cap API spending when the app is publicly reachable.
# Running it with your own key, raise them freely.
# MAX_FORMS=5
# RATE_LIMIT_SECONDS=60

# Werkzeug's debugger allows arbitrary code execution through the browser.
# Leave this off anywhere the port is reachable by someone else.
# FLASK_DEBUG=1

# Send the session cookie only over HTTPS. Turn this on wherever you deploy.
# SESSION_COOKIE_SECURE=1

# OPENAI_MODEL=gpt-4o
# DATABASE=fillbot.db
